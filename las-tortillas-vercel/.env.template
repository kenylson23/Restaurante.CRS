# =========================================================
# CONFIGURAÇÃO DE AMBIENTE - LAS TORTILLAS
# =========================================================

# ─────────────────────────────────────────────────────────
# 🗃️ NEON DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────
# Obtenha estas informações no dashboard do Neon:
# https://console.neon.tech/app/projects

# URL completa do banco de dados (OBRIGATÓRIO)
DATABASE_URL=postgresql://usuario:senha@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb

# Alternativas para teste (descomente se DATABASE_URL não funcionar)
# NEON_DATABASE_URL=postgresql://usuario:senha@ep-xxx-xxx.us-east-2.aws.neon.tech:5432/neondb
# NEON_DATABASE_URL_POOLER=postgresql://usuario:senha@ep-xxx-xxx.us-east-2.aws.neon.tech:6543/neondb

# Configurações adicionais para o Neon
NEON_PROJECT_ID=seu-project-id-neon
NEON_BRANCH=main

# ─────────────────────────────────────────────────────────
# 🌐 SUPABASE CONFIGURATION (Para storage de imagens)
# ─────────────────────────────────────────────────────────
# Obtenha estas informações no dashboard do Supabase:
# https://supabase.com/dashboard/project/SEU-PROJECT-ID/settings/api

SUPABASE_URL=https://seu-project-id.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui

# ─────────────────────────────────────────────────────────
# 🖥️ BACKEND CONFIGURATION (Para Render)
# ─────────────────────────────────────────────────────────
# URL do backend quando deployed no Render
VITE_API_URL=https://las-tortillas-api.onrender.com

# URL local para desenvolvimento
VITE_API_URL_LOCAL=http://localhost:3001

# ─────────────────────────────────────────────────────────
# 🎨 FRONTEND CONFIGURATION (Para Vercel)
# ─────────────────────────────────────────────────────────
# URL do frontend quando deployed na Vercel
VITE_APP_URL=https://seu-frontend.vercel.app

# URL local para desenvolvimento
VITE_APP_URL_LOCAL=http://localhost:5173

# ─────────────────────────────────────────────────────────
# 🔐 SECURITY & AUTH
# ─────────────────────────────────────────────────────────
# Chave secreta para JWT (gere uma aleatória)
JWT_SECRET=sua-chave-super-secreta-aqui-min-32-chars

# WhatsApp configuration
WHATSAPP_NUMBER=+244949639932

# ─────────────────────────────────────────────────────────
# 🚀 DEPLOYMENT ENVIRONMENT
# ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─────────────────────────────────────────────────────────
# 📝 INSTRUÇÕES DE USO:
# ─────────────────────────────────────────────────────────
# 1. Renomeie este arquivo para .env.local
# 2. Preencha todas as variáveis com seus valores reais
# 3. Execute: npm run test-neon-connection
# 4. Se a conexão funcionar, execute: npm run migrate
#
# IMPORTANTE: 
# - Nunca commite este arquivo com valores reais
# - Use valores diferentes para desenvolvimento e produção
# - Mantenha as chaves seguras
# ─────────────────────────────────────────────────────────

# =========================================================
# EXEMPLO DE URLs NEON:
# =========================================================
# Formato geral:
# postgresql://[user]:[password]@[host]:[port]/[database]
#
# Exemplo real:
# postgresql://neondb_owner:AbCdEf123@ep-cool-mountain-a5b6c7d8.us-east-2.aws.neon.tech/neondb
#
# Variações para teste:
# - Porta 5432: ...neon.tech:5432/neondb
# - Porta 6543: ...neon.tech:6543/neondb (pooler)
# - Com SSL: ...neondb?sslmode=require
# =========================================================